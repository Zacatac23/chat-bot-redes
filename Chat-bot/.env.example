# Google Gemini API Key (100% Free at https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Express Server Port (Web UI Inspector)
PORT=3000

# Remote MCP Server Port (when running remote server locally)
REMOTE_PORT=8080

# Remote MCP Server Endpoint URL (leave empty to use local stdio server)
# Example: http://localhost:8080/mcp or https://your-cloudrun-url.a.run.app/mcp
REMOTE_PHARMA_MCP_URL=http://localhost:8080/mcp
